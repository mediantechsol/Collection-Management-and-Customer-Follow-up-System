VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# النطاق الداخلي المستخدم لتحويل اسم المستخدم إلى إيميل مصادقة (يجب أن يطابق ما في قاعدة البيانات)
VITE_INTERNAL_EMAIL_DOMAIN=dr-ayman.local
